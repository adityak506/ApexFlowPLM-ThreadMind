      "title": "ECR Lifecycle State Transitions",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (status) (plm_threadmind_ecr_drafts_total)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
