# PLM Backend Selection: 'mock' (default) or 'windchill'
PLM_BACKEND=mock

# SQLite Database Path for MockBackend
PLM_SQLITE_PATH=plm_mock.db

# Seed database on startup if empty (true/false)
PLM_SEED_ON_STARTUP=true

# Future Windchill Connection Settings (Used when PLM_BACKEND=windchill)
# TODO: verify against Windchill docs
WINDCHILL_BASE_URL=https://windchill.example.com/Windchill
WINDCHILL_USERNAME=
WINDCHILL_PASSWORD=
WINDCHILL_CONTAINER=Demo Product

